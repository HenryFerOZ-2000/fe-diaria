rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isNonEmptyString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }
    // Live posts: lectura pública; escritura directa desde cliente autenticado permitida
    // (las funciones callable usan admin SDK y no dependen de rules)
    match /live_posts/{postId} {
      allow read: if true;
      // Crear posts solo via Cloud Functions (admin SDK).
      allow create: if false;
      // Actualizar post: solo el autor, o actualizaciones de contadores (likeCount, commentCount)
      allow update: if request.auth != null 
                    && (resource.data.authorUid == request.auth.uid
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount'])));
      // Eliminar post: solo el autor
      allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;
      
      // Likes: cualquier usuario autenticado puede crear/eliminar su propio like
      match /likes/{uid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // Comentarios: cualquier usuario autenticado puede crear comentarios
      match /comments/{commentId} {
        allow read: if true;
        // Crear comentarios solo via Cloud Functions (admin SDK).
        allow create: if false;
        // Actualizar comentario: solo el autor o actualizaciones de contadores
        allow update: if request.auth != null 
                      && (resource.data.authorUid == request.auth.uid
                          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'replyCount'])));
        allow delete: if request.auth != null 
                      && resource.data.authorUid == request.auth.uid;
        
        // Likes en comentarios
        match /likes/{uid} {
          allow read: if true;
          allow create: if request.auth != null && request.auth.uid == uid;
          allow delete: if request.auth != null && request.auth.uid == uid;
        }
      }
    }

    // Perfiles de usuario
    match /users/{userId} {
      // Permitir lectura si el usuario está autenticado
      // Esto permite que cualquier usuario autenticado vea perfiles de otros usuarios
      // (el propietario siempre puede ver su propio perfil)
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(['username', 'usernameLower'])
                    && (!request.resource.data.keys().hasAny(['displayName'])
                        || isNonEmptyString(request.resource.data.displayName, 60));
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['username', 'usernameLower']))
                    && (!(request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']))
                        || isNonEmptyString(request.resource.data.displayName, 60));
      allow delete: if false;

      // Favoritos del usuario (versos/posts)
      match /favorites/{favId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Seguidores / Following: solo lectura pública; escrituras vía Cloud Functions (admin)
      match /followers/{followerUid} {
        allow read: if true;
        allow write: if false;
      }

      match /following/{targetUid} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Estadísticas espirituales: solo el propietario puede leer/escribir
      match /spiritualStats/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Progreso diario: solo el propietario puede leer/escribir
      match /dailyProgress/{dateId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Lock técnico de usernames: solo backend (admin SDK)
    match /username_locks/{username} {
      allow read: if false;
      allow write: if false;
    }

    // Legado: colección anterior de reserva de usernames
    match /username_map/{username} {
      allow read: if false;
      allow write: if false;
    }

    // --- Comunidades (Mi Comunidad / códigos de invitación) ---
    match /communities/{communityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.adminIds is list
                    && request.resource.data.adminIds.size() == 1
                    && request.resource.data.adminIds[0] == request.auth.uid
                    && request.resource.data.isVerified == false
                    && request.resource.data.inviteCode is string
                    && request.resource.data.name is string
                    && request.resource.data.city is string
                    && request.resource.data.description is string;
      allow update: if request.auth != null && (
                      (
                        resource.data.adminIds.hasAny([request.auth.uid])
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['createdBy', 'inviteCode', 'adminIds', 'isVerified'])
                      )
                      ||
                      (
                        resource.data.createdBy == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['adminIds', 'createdBy', 'updatedAt'])
                        && request.resource.data.inviteCode == resource.data.inviteCode
                        && request.resource.data.isVerified == resource.data.isVerified
                        && request.resource.data.name == resource.data.name
                        && request.resource.data.city == resource.data.city
                        && request.resource.data.description == resource.data.description
                        && request.resource.data.createdBy is string
                        && request.resource.data.adminIds is list
                        && request.resource.data.adminIds.size() > 0
                        && request.resource.data.adminIds.hasAll([request.resource.data.createdBy])
                      )
                      ||
                      (
                        resource.data.adminIds.hasAny([request.auth.uid])
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['adminIds', 'updatedAt'])
                        && request.resource.data.createdBy == resource.data.createdBy
                        && request.resource.data.inviteCode == resource.data.inviteCode
                        && request.resource.data.isVerified == resource.data.isVerified
                        && request.resource.data.name == resource.data.name
                        && request.resource.data.city == resource.data.city
                        && request.resource.data.description == resource.data.description
                        && request.resource.data.adminIds is list
                        && request.resource.data.adminIds.size() == resource.data.adminIds.size() - 1
                        && !request.resource.data.adminIds.hasAny([request.auth.uid])
                        && request.auth.uid != resource.data.createdBy
                      )
                    );
      allow delete: if false;
    }

    // --- Publicaciones internas de comunidad (likes/comentarios como live_posts) ---
    match /community_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.communityId is string
                    && exists(/databases/$(database)/documents/communities/$(request.resource.data.communityId))
                    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && get(/databases/$(database)/documents/users/$(request.auth.uid))
                        .data.communityId == request.resource.data.communityId
                    && (
                      get(/databases/$(database)/documents/communities/$(request.resource.data.communityId))
                          .data.adminIds.hasAny([request.auth.uid])
                      || !get(/databases/$(database)/documents/communities/$(request.resource.data.communityId))
                          .data.keys().hasAny(['membersCanPost'])
                      || get(/databases/$(database)/documents/communities/$(request.resource.data.communityId))
                          .data.membersCanPost == true
                    )
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['likeCount', 'commentCount']);
      allow delete: if request.auth != null
                    && (
                      resource.data.authorId == request.auth.uid
                      || (
                        resource.data.communityId is string
                        && exists(/databases/$(database)/documents/communities/$(resource.data.communityId))
                        && get(/databases/$(database)/documents/communities/$(resource.data.communityId))
                            .data.adminIds.hasAny([request.auth.uid])
                      )
                    );

      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.authorUid == request.auth.uid;
        allow update: if request.auth != null
                      && (resource.data.authorUid == request.auth.uid
                          || (request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['likeCount', 'replyCount'])));
        allow delete: if request.auth != null
                      && resource.data.authorUid == request.auth.uid;

        match /likes/{uid} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.auth.uid == uid;
          allow delete: if request.auth != null && request.auth.uid == uid;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
